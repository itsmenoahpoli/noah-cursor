{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "{index,cli,main,app,server}.{js,cjs,mjs,ts,cts,mts}",
    "src/{index,cli,main,app,server}.{js,cjs,mjs,ts,cts,mts}",
    "bin/**/*.{js,cjs,mjs,ts}",
    "scripts/**/*.{js,cjs,mjs,ts}"
  ],
  "project": [
    "**/*.{js,cjs,mjs,ts,cts,mts}!"
  ],
  "ignore": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/node_modules/**"
  ],
  "ignoreBinaries": [
    "noah-cursor"
  ]
}
